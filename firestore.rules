rules_version = '2';

// BSTJ DATA MASTER Schema v3.0
// Rule 4 (Core Architecture): Client SDK is Read-Only / Create-Request only.
// All financial writes (amounts, levels, case status) happen exclusively
// through Cloud Functions using the Admin SDK, which bypasses these rules.
// Every "allow write" below is false on purpose.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwner(memberId) {
      return isSignedIn() && request.auth.uid == memberId;
    }

    // 01_members
    match /members/{memberId} {
      allow read: if isOwner(memberId) || isAdmin();
      allow write: if false; // Admin SDK only
    }

    // 02_donation_cases
    match /donation_cases/{caseId} {
      allow read: if resource.data.approval_status in ["APPROVED", "FUNDING", "COMPLETED"]
                   || isOwner(resource.data.requester_id)
                   || isAdmin();
      allow write: if false; // Admin SDK only
    }

    match /case_documents/{docId} {
      allow read: if isAdmin() || isOwner(resource.data.member_id);
      allow write: if false;
    }

    // 03_receipts & funds
    match /receipts/{receiptId} {
      allow read: if isOwner(resource.data.member_id) || isAdmin();
      allow write: if false; // Admin SDK only
    }

    match /fund_MNTN/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /fund_TheStar/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /backend_TheStar_MNTN/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 04_products_blackcat & auctions
    match /products_blackcat/{productId} {
      allow read: if true;
      allow write: if false; // Admin SDK only
    }

    match /auction_items/{itemId} {
      allow read: if true;
      allow write: if false;
    }

    match /auction_bids/{bidId} {
      allow read: if isAdmin() || isOwner(resource.data.member_id);
      allow write: if false; // bids are placed via a Cloud Function create-request
    }

    // 05_complaints & audit_logs
    match /complaints/{complaintId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /wardens/{wardenId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /donor_inboxes/{inboxId} {
      allow read: if isOwner(resource.data.donor_id) || isAdmin();
      allow write: if false;
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Admin SDK only, sealed with sha256_seal_hash
    }

    // System collections
    match /system_config/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /security_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Comet Recoil Protocol: pending STAR allocations (max 5-minute window)
    match /pending_allocations/{allocationId} {
      allow read: if isOwner(resource.data.member_id) || isAdmin();
      allow write: if false; // created and resolved by Cloud Functions only
    }

    match /system_vault/{docId} {
      allow read: if isAdmin();
      allow write: if false; // seizedStar lives here
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
